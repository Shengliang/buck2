[cells]
root = .
prelude = prelude
toolchains = toolchains
none = none

[cell_aliases]
config = prelude
fbcode = none
fbsource = none
buck = none

[external_cells]
  prelude = bundled

[repositories]
  root = .
  libA = libA
  libB = libB
  libC1 = libC1
  libC2 = libC2

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default

